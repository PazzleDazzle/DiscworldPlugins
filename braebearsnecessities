-- Combat detection: Discworld's Hp/Gp/Xp status line omits the trailing
-- "Burden: n%" field specifically on combat-round updates; the same line
-- WITH Burden is the ordinary prompt. (Confirmed from Quow's CowBar plugin,
-- QuowHandleScoreBrief - see the separate CombatState plugin for the same
-- logic in isolation.)
function BBHandleScoreBrief(name, line, wildcards, styles)
  local burden = wildcards[6]
  if burden == nil or burden == "" then
    g_lastCombatTime = os.time()
    if not g_inCombat then
      g_inCombat = true
      Draw()
    end
  end
end

function BBTick()
  if g_inCombat and g_lastCombatTime and (os.time() - g_lastCombatTime) >= COMBAT_TIMEOUT then
    g_inCombat = false
    g_lastCombatTime = nil
    Draw()
  end
  if g_flashUntil ~= 0 and os.time() >= g_flashUntil then
    g_flashUntil = 0
    Draw()
  end
  local now = os.time()
  local changed = false
  for _,v in ipairs(g_weapons) do
    local key = string.lower(v.name)
    local rec = g_coatStartTime[key]
    if type(rec) == "table" then
      local lastReal = g_coatLastReal[key] or 0
      if (now - lastReal) >= COAT_REAL_GRACE then
        local avg = GetCoatAvgDuration(rec.coating)
        if avg and avg > 0 then
          local frac = (now - rec.time) / avg
          if frac < 0 then frac = 0 elseif frac > 1 then frac = 1 end
          local idx = math.floor(frac * (#COAT_STAGES - 1)) + 1
          if idx < 1 then idx = 1 elseif idx > #COAT_STAGES then idx = #COAT_STAGES end
          local estimated = COAT_STAGES[idx]
          if v.level ~= estimated then
            v.level = estimated
            changed = true
          end
        end
      end
    end
  end
  if changed then SaveState() Draw() end
end

