local CANTEEN_LABELS = {
  [6]="full", [5]="almost full", [4]="3/4 full", [3]="half full",
  [2]="1/4 full", [1]="almost empty", [0]="empty"
}

local CANTEEN_PATTERNS = {
  {pat="completely empty", lvl=0},
  {pat="almost empty", lvl=1},
  {pat="one-quarter full", lvl=2},
  {pat="half full", lvl=3},
  {pat="three-quarters full", lvl=4},
  {pat="almost full", lvl=5},
  {pat="completely full", lvl=6},
}

local function ResolveCanteenLevel(text)
  local t = string.lower(Trim(text or ""))
  for _,p in ipairs(CANTEEN_PATTERNS) do
    if t:find(p.pat, 1, true) then return p.lvl end
  end
  return nil
end

local function FindCanteenConfig(keyword)
  for _,c in ipairs(g_canteenConfig) do
    if c.keyword == keyword then return c end
  end
  return nil
end

local function FindScrollConfigByKeyword(keyword)
  for _,s in ipairs(g_scrollConfig) do
    if s.keyword == keyword then return s end
  end
  return nil
end

local function FindScrollConfigByCounter(counter)
  for _,s in ipairs(g_scrollConfig) do
    if string.lower(s.counter) == string.lower(counter) then return s end
  end
  return nil
end

-- These use AddTriggerEx to create/replace triggers at runtime, since the
-- text they need to match (a user-chosen cast phrase, or a user-chosen
-- armband container name) isn't known until the user configures it. The
-- eReplace flag means calling this again just overwrites the old trigger of
-- the same name, so it's safe to call every time state loads or settings
-- change.
function RegisterScrollCastTrigger(entry)
  if not entry or not entry.counter or entry.counter == "" then return end
  if not entry.castPhrase or entry.castPhrase == "" then return end
  local triggerName = "BBScrollCast_" .. (entry.counter:gsub("[^%w]", "_"))
  local pattern = EscapeRegex(entry.castPhrase)
  local flags = trigger_flag.Enabled + trigger_flag.RegularExpression + trigger_flag.Replace
  pcall(AddTriggerEx, triggerName, pattern, 'DecrementScrollCounter("' .. entry.counter .. '")',
    flags, custom_colour.NoChange, 0, "", "", 12, 100)
end

function RegisterScrollCastTrigger(entry)
  if not entry or not entry.counter or entry.counter == "" then return end
  if not entry.castPhrase or entry.castPhrase == "" then return end
  local triggerName = "BBScrollCast_" .. (entry.counter:gsub("[^%w]", "_"))
  local pattern = EscapeRegex(entry.castPhrase)
  local flags = trigger_flag.Enabled + trigger_flag.RegularExpression + trigger_flag.Replace
  pcall(AddTriggerEx, triggerName, pattern, 'DecrementScrollCounter("' .. entry.counter .. '")',
    flags, custom_colour.NoChange, 0, "", "", 12, 100)
end

-- ---------------------------------------------------------------
-- Spell components: each named component has its own count plus a list of
-- "add" phrases and a list of "remove" phrases (multiple of each allowed).
-- Every phrase becomes its own dynamic trigger via AddTriggerEx.
-- ---------------------------------------------------------------
local function SanitizeCompTriggerName(name)
  return (name:gsub("[^%w]", "_"))
end

function RegisterComponentTrigger(name, direction, index, phrase)
  if not phrase or phrase == "" then return end
  local triggerName = "BBComp_" .. SanitizeCompTriggerName(name) .. "_" .. direction .. index
  local pattern = EscapeRegex(phrase)
  local flags = trigger_flag.Enabled + trigger_flag.RegularExpression + trigger_flag.Replace
  local delta = (direction == "add") and 1 or -1
  pcall(AddTriggerEx, triggerName, pattern, 'AdjustComponent("' .. name .. '",' .. delta .. ')',
    flags, custom_colour.NoChange, 0, "", "", 12, 10)
end

function RefreshComponentTriggers(name, direction)
  local cfg = g_componentConfig[name]
  if not cfg then return end
  -- Delete a generous number of potential stale trigger slots first, then
  -- re-register the current list fresh, so removing/reordering a phrase
  -- can never leave a mismatched live trigger behind.
  for i=1,25 do pcall(DeleteTrigger, "BBComp_" .. SanitizeCompTriggerName(name) .. "_" .. direction .. i) end
  for i,phrase in ipairs(cfg[direction] or {}) do
    RegisterComponentTrigger(name, direction, i, phrase)
  end
end

function AdjustComponent(name, delta)
  if g_components[name] == nil then g_components[name] = 0 end
  g_components[name] = math.max(0, g_components[name] + delta)
  SaveState()
  Draw()
  ColourNote("cyan","","BraeBear's Necessities: " .. name .. " " .. (delta>0 and ("+"..delta) or tostring(delta)) .. " (now " .. g_components[name] .. ")")
  if g_components[name] == 0 then PlayAlertSound(false) TriggerBorderFlash() end
end

function AddComponent(name)
  name = Trim(name or "")
  if name == "" then ColourNote("yellow","","Usage: bbcompadd <name>") return end
  if g_componentConfig[name] then
    ColourNote("yellow","","BraeBear's Necessities: component '" .. name .. "' already exists")
    return
  end
  g_components[name] = g_components[name] or 0
  g_componentConfig[name] = {add={}, remove={}}
  SaveState()
  Draw()
  ColourNote("palegreen","","BraeBear's Necessities: added spell component '" .. name .. "' - now add triggers with bbcompaddtrigger/bbcompremtrigger")
end

function RemoveComponent(name)
  name = Trim(name or "")
  local cfg = g_componentConfig[name]
  if not cfg then ColourNote("yellow","","BraeBear's Necessities: no component '" .. name .. "'") return end
  for i=1,25 do
    pcall(DeleteTrigger, "BBComp_" .. SanitizeCompTriggerName(name) .. "_add" .. i)
    pcall(DeleteTrigger, "BBComp_" .. SanitizeCompTriggerName(name) .. "_remove" .. i)
  end
  g_componentConfig[name] = nil
  g_components[name] = nil
  SaveState()
  Draw()
  ColourNote("orange","","BraeBear's Necessities: removed spell component '" .. name .. "'")
end

function SetComponentCount(name, n)
  name = Trim(name or "")
  n = tonumber(n)
  if not g_componentConfig[name] then ColourNote("yellow","","BraeBear's Necessities: no component '" .. name .. "' - use bbcompadd first") return end
  if not n then ColourNote("yellow","","Usage: bbcompset <name> <number>") return end
  g_components[name] = math.max(0, math.floor(n))
  SaveState()
  Draw()
  ColourNote("palegreen","",name .. " set to " .. g_components[name])
end

function AddComponentTriggerPhrase(name, direction, phrase)
  name = Trim(name or "")
  phrase = Trim(phrase or "")
  local cfg = g_componentConfig[name]
  if not cfg then ColourNote("yellow","","BraeBear's Necessities: no component '" .. name .. "' - use bbcompadd first") return end
  if phrase == "" then ColourNote("yellow","","Usage: bbcompaddtrigger/bbcompremtrigger <name> <phrase>") return end
  table.insert(cfg[direction], phrase)
  RefreshComponentTriggers(name, direction)
  SaveState()
  ColourNote("palegreen","","BraeBear's Necessities: added " .. direction .. " trigger #" .. #cfg[direction] .. " for '" .. name .. "': \"" .. phrase .. "\"")
