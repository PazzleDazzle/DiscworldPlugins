local function GetConditionColor(percent)
  if not percent then return 0x888888 end
  if percent<0 then percent=0 end
  if percent>100 then percent=100 end
  local r,g
  if percent >= 50 then g=255 r=math.floor(255 * (100 - percent) / 50)
  else r=255 g=math.floor(255 * percent / 50) end
  return g*256 + r
end

local function DrawSegmentedBarGradient(winId, x, y, w, h, percent, segments, gap, filledCountOverride)
  if not segments or segments <1 then segments=10 end
  if not gap then gap=3 end
  if not percent then percent=0 end
  if percent<0 then percent=0 end
  if percent>100 then percent=100 end
  local bgCol = 0x222222
  local borderCol = 0x444444
  local segW = math.floor((w - (segments-1)*gap) / segments)
  if segW < 2 then segW = 2 end
  local filledSegs
  if filledCountOverride ~= nil then filledSegs = filledCountOverride
  else filledSegs = math.floor((percent / 100) * segments + 0.5) end
  for i=1, segments do
    local sx = x + (i-1)*(segW+gap)
    WindowRectOp(winId, 2, sx, y, sx+segW, y+h, bgCol)
    WindowRectOp(winId, 1, sx, y, sx+segW, y+h, borderCol)
    if i <= filledSegs then
      local segMidPct = (i - 0.5) * (100 / segments)
      local col = GetConditionColor(segMidPct)
      WindowRectOp(winId, 2, sx+1, y+1, sx+segW-1, y+h-1, col)
    end
  end
end

