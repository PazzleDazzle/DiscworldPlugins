function RegisterLightTriggers()
  if not g_lightItem or g_lightItem == "" then return end
  local esc = EscapeRegex(g_lightItem)
  local flags = trigger_flag.Enabled + trigger_flag.RegularExpression + trigger_flag.Replace
  -- "wear" and "remove" messages don't necessarily use the same article
  -- ("a keyring necklace" vs "the keyring necklace"), so make it optional
  -- and match on the bare item name instead of requiring a specific one.
  pcall(AddTriggerEx, "BBIconLightOn", "^You wear (?:an? |the )?" .. esc .. "\\.$",
    "SetLight(true)", flags, custom_colour.NoChange, 0, "", "", 12, 10)
  pcall(AddTriggerEx, "BBIconLightOff", "^You remove (?:an? |the )?" .. esc .. "\\.$",
    "SetLight(false)", flags, custom_colour.NoChange, 0, "", "", 12, 10)
end

