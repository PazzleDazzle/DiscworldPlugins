function AddArmbandSlot(slotWord, rest)
  local slotNum = WordToNum(slotWord)
  if slotNum == 0 then slotNum = #g_armband + 1 end
  rest = Trim(rest or "")
  local count = 0
  local label = rest
  local first = rest:match("^(%S+)")
  local c = WordToNum(first or "")
  if c > 0 then
    count = c
    label = rest:gsub("^%S+%s+doses?%s+of%s+", "", 1)
    label = label:gsub("^%S+%s+doses?%s*", "", 1)
    label = Trim(label)
    if label == "" then label = rest end
  else
    if rest:lower():find("nothing") or rest:lower():find("empty") then count=0 label="empty"
    else label = rest end
  end
  g_armband[slotNum] = {count=count, label=label, raw=rest, slot=slotNum}
  SaveState()
  Draw()
end

local function RefreshCoatFull(weaponName)
