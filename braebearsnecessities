-- Per-character profiles: variable keys are namespaced by profile name so
-- switching profiles gives a character its own weapons/armband/whitelist/etc,
-- while the "default" profile keeps the original (unprefixed) variable names
-- so existing data isn't lost or migrated.
local g_profile = GetVariable("g_activeProfile") or "default"

local function VK(key)
  if g_profile == "default" or g_profile == "" then return key end
  return g_profile .. ":" .. key
end

local ALLOWED_WEAPONS = {}

local function LoadWhitelist()
  local defaults = {grizzly=true, kodiak=true, kaa=true, ["shere khan"]=true}
  local raw = GetVariable(VK("g_whitelist"))
  if raw and raw ~= "" then
    local ok,d = pcall(json.decode, raw)
    if ok and d and type(d)=="table" then
      ALLOWED_WEAPONS = {}
      for k,_ in pairs(d) do ALLOWED_WEAPONS[string.lower(k)] = true end
      return
    end
  end
  ALLOWED_WEAPONS = defaults
  SaveWhitelist()
end

function SaveWhitelist()
  SetVariable(VK("g_whitelist"), json.encode(ALLOWED_WEAPONS))
end

local function IsAllowed(name)
  if not name then return false end
  return ALLOWED_WEAPONS[string.lower(Trim(name))] == true
end

function SetMaxWeapons(n)
  n = tonumber(n)
  if not n then
    ColourNote("yellow","","Usage: coatmax <number>  e.g. coatmax 2  (1-10)")
    ColourNote("yellow","","Current: " .. tostring(g_maxWeapons))
    return
  end
  n = math.floor(n)
  if n < 1 then n = 1 end
  if n > 10 then n = 10 end
  g_maxWeapons = n
  if #g_weapons > g_maxWeapons then
    table.sort(g_weapons, function(a,b) return a.time > b.time end)
    while #g_weapons > g_maxWeapons do table.remove(g_weapons) end
  end
  SaveState()
  Draw()
  ColourNote("palegreen","","Max weapons set to " .. tostring(g_maxWeapons))
end

function ShowWhitelist()
  local list = {}
  for k,_ in pairs(ALLOWED_WEAPONS) do table.insert(list, k) end
  table.sort(list)
  ColourNote("cyan","","--- BraeBear's Necessities Whitelist ---")
  if #list==0 then ColourNote("yellow",""," (empty)")
  else for _,n in ipairs(list) do ColourNote("white","","  - " .. n) end end
  ColourNote("cyan","","Use: coatadd <name> | coatremove <name>")
end

function AddWeapon(name)
  name = Trim(name or "")
  if name=="" then ColourNote("yellow","","Usage: coatadd <name>") return end
  local key = string.lower(name)
  if ALLOWED_WEAPONS[key] then ColourNote("yellow","","Already in whitelist: " .. name)
  else ALLOWED_WEAPONS[key]=true SaveWhitelist() ColourNote("palegreen","","Added: " .. name) ShowWhitelist() end
end

function RemoveWeapon(name)
  name = Trim(name or "")
  if name=="" then ColourNote("yellow","","Usage: coatremove <name>") return end
  local key = string.lower(name)
  if ALLOWED_WEAPONS[key] then ALLOWED_WEAPONS[key]=nil SaveWhitelist() ColourNote("orange","","Removed: " .. name) ShowWhitelist()
  else ColourNote("yellow","","Not in whitelist: " .. name) end
end

