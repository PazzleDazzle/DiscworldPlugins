-- ---------------------------------------------------------------
-- Fast base64 decoder (table/arithmetic based - the common bit-string-
-- expansion snippets found online are far too slow for ~500KB of embedded
-- image data). Verified byte-exact against the real source images before
-- being embedded here.
-- ---------------------------------------------------------------
local B64CHARS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'
local B64LOOKUP = {}
for i = 1, #B64CHARS do B64LOOKUP[B64CHARS:sub(i,i)] = i - 1 end

local function base64_decode(data)
  local out = {}
  local outIdx = 1
  local len = #data
  local i = 1
  while i <= len do
    local c1 = B64LOOKUP[data:sub(i,i)] or 0
    local c2 = B64LOOKUP[data:sub(i+1,i+1)] or 0
    local c3chr = data:sub(i+2,i+2)
    local c4chr = data:sub(i+3,i+3)
    local c3 = B64LOOKUP[c3chr]
    local c4 = B64LOOKUP[c4chr]
    local b1 = (c1 * 4) + math.floor(c2 / 16)
    out[outIdx] = string.char(b1); outIdx = outIdx + 1
    if c3chr ~= '=' and c3chr ~= '' then
      local b2 = ((c2 % 16) * 16) + math.floor((c3 or 0) / 4)
      out[outIdx] = string.char(b2); outIdx = outIdx + 1
      if c4chr ~= '=' and c4chr ~= '' then
        local b3 = (((c3 or 0) % 4) * 64) + (c4 or 0)
        out[outIdx] = string.char(b3); outIdx = outIdx + 1
      end
    end
    i = i + 4
  end
  return table.concat(out)
end

