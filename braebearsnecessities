function CountScrollLine(identifier)
  identifier = string.lower(Trim(identifier or ""))
  local cfg = FindScrollConfigByKeyword(identifier)
  if not cfg then return end
  local now = os.clock()
  if now - (g_scrollLastSeen or 0) > SCROLL_BATCH_GAP then
    g_scrollCounts = {}
    -- A new "check papers" batch is starting: zero every configured counter
    -- up front, not just the ones that turn out to have a matching line.
    -- Otherwise a counter you've run out of entirely (no lines at all this
    -- batch) never gets told to reset, and just keeps showing its last count.
    for _,s in ipairs(g_scrollConfig) do g_scrollCounters[s.counter] = 0 end
  end
  g_scrollLastSeen = now
  g_scrollCounts[cfg.counter] = (g_scrollCounts[cfg.counter] or 0) + 1
  g_scrollCounters[cfg.counter] = g_scrollCounts[cfg.counter]
  SaveState()
  Draw()
end

