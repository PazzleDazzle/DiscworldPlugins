  if weaponName == "" or not IsAllowed(weaponName) then return end
  local found = nil
  for i,v in ipairs(g_weapons) do
    if string.lower(v.name) == string.lower(weaponName) then found = i break end
  end
  if found then
    g_weapons[found].level = "very thick"
    g_weapons[found].time = os.time()
  else
    ColourNote("red","","BraeBear's Necessities: could not match '" .. weaponName .. "' to a tracked weapon - adding new entry")
    table.insert(g_weapons, {name=weaponName, level="very thick", condition="", time=os.time()})
  end
  table.sort(g_weapons, function(a,b) return a.time > b.time end)
end

local function ResolveAllowedWeaponFromText(text)
  if not text then return nil end
  local t = string.lower(text)
  local best, bestLen = nil, -1
  for k,_ in pairs(ALLOWED_WEAPONS) do
    if t:find(k, 1, true) and #k > bestLen then
      best = k
      bestLen = #k
    end
  end
  return best
end

local function ConsumeArmbandDose(weaponName, noteSuffix)
  local target = nil
  if g_nextCoatSlot and g_armband[g_nextCoatSlot] then
    target = g_armband[g_nextCoatSlot]
  else
    local slots = {}
    for _,v in pairs(g_armband) do table.insert(slots, v) end
    table.sort(slots, function(a,b) return a.slot < b.slot end)
    for _,s in ipairs(slots) do
      if s.count and s.count > 0 and s.label ~= "empty" then target = s break end
    end
  end
  if not target or not target.count or target.count <= 0 then
    ColourNote("red","","BraeBear's Necessities: no valid armband target (examine your armband recently?)")
    return nil
  end
  target.count = target.count - 1
  if target.count <= 0 then
    target.count = 0
    target.label = "empty"
    target.raw = "nothing"
    PlayAlertSound(false)
    TriggerBorderFlash()
  end
  g_armband[target.slot] = target
  SaveState()
  Draw()
  return target
end

function GetCoatAvgDuration(coating)
  coating = string.lower(Trim(coating or "unknown"))
  local b = g_coatAvgByType[coating]
  if not b or b.count <= 0 then return nil, 0 end
  return b.sum / b.count, b.count
end

function StartCoatTimer(weapon, coating)
  if not weapon or weapon == "" then return end
  weapon = string.lower(weapon)
  if coating and Trim(coating) ~= "" then
    coating = string.lower(Trim(coating))
  else
    -- No coating name available from this event (e.g. the plain armband
    -- apply message doesn't name the substance) - keep whatever coating
    -- name we already had timing for this weapon, if any.
    local prev = g_coatStartTime[weapon]
    coating = (type(prev) == "table" and prev.coating) or "unknown"
  end
  local rec = {time = os.time(), coating = coating}
  if g_coatMethod == "formula" and g_brewerBonus and g_brewerBonus > 0 then
    local total = 4 * g_brewerBonus
    if total > 0 then
      rec.totalSeconds = total
      rec.remaining = total
    end
  end
  g_coatStartTime[weapon] = rec
end

-- Formula-method hit event: each occurrence costs 10 seconds off the
-- remaining total for that weapon's current coat, immediately updating the
-- displayed level. Weapons using the average method (or with no bonus known
-- at application time) simply have no .remaining field and are unaffected.
function HandleCoatHit(weaponRaw)
  local resolved = ResolveAllowedWeaponFromText(weaponRaw)
  if not resolved then return end
  local rec = g_coatStartTime[resolved]
  if type(rec) ~= "table" or not rec.remaining or not rec.totalSeconds or rec.totalSeconds <= 0 then return end
  rec.remaining = math.max(0, rec.remaining - 10)
  local frac = 1 - (rec.remaining / rec.totalSeconds)
  if frac < 0 then frac = 0 elseif frac > 1 then frac = 1 end
  local idx = math.floor(frac * (#COAT_STAGES - 1)) + 1
  if idx < 1 then idx = 1 elseif idx > #COAT_STAGES then idx = #COAT_STAGES end
  local estimated = COAT_STAGES[idx]
  local changed = false
  for _,v in ipairs(g_weapons) do
    if string.lower(v.name) == resolved and v.level ~= estimated then
      v.level = estimated
      changed = true
    end
  end
  if changed then SaveState() Draw() end
end

function HandleCoatDepleted(coating, weaponRaw)
  local resolved = ResolveAllowedWeaponFromText(weaponRaw)
  if not resolved then return end
  SetLastWeapon(resolved)
  local rec = g_coatStartTime[resolved]
  local coatingKey = string.lower(Trim(coating or "unknown"))
  if type(rec) == "table" then
    local elapsed = os.time() - rec.time
    -- Prefer the coating name captured at application start (ground truth
    -- for that instance) in case this message ever phrases it differently.
    local bucketKey = rec.coating or coatingKey
    if elapsed > 0 then
      local b = g_coatAvgByType[bucketKey] or {sum=0, count=0}
      b.sum = b.sum + elapsed
      b.count = b.count + 1
      g_coatAvgByType[bucketKey] = b
    end
    g_coatStartTime[resolved] = nil
    coatingKey = bucketKey
  end
  for _,v in ipairs(g_weapons) do
    if string.lower(v.name) == resolved then
      v.level = "none"
      v.time = os.time()
    end
  end
  SaveState()
  Draw()
  local avg, count = GetCoatAvgDuration(coatingKey)
  ColourNote("orange","","BraeBear's Necessities: " .. resolved .. "'s coat (" .. coatingKey .. ") ran out" ..
    (avg and (" (avg duration for this coating now " .. math.floor(avg) .. "s over " .. count .. " samples)") or ""))
end

-- Both of these messages, despite one sounding partial ("looks a little
-- thicker now"), apparently always mean the coat is now fully topped up to
-- "very thick" - confirmed by the person, not guessed. Treat both as an
-- authoritative full-coat event: refresh the level and (re)start the
-- duration timer, same as a successful armband application.
function HandleCoatConfirmedFull(weaponRaw, coating)
  local resolved = ResolveAllowedWeaponFromText(weaponRaw)
  if not resolved then return end
  local rcOk, rcErr = pcall(RefreshCoatFull, resolved)
  if not rcOk then
    ColourNote("red","","BraeBear's Necessities: RefreshCoatFull error: " .. tostring(rcErr))
    return
  end
  StartCoatTimer(resolved, coating)
  g_coatLastReal[resolved] = os.time()
  SaveState()
  Draw()
end

function ApplyArmbandDose(weaponName)
  local target = ConsumeArmbandDose(weaponName)
  if target then
    local resolved = ResolveAllowedWeaponFromText(weaponName) or g_nextCoatWeapon
    local rcOk, rcErr = pcall(RefreshCoatFull, resolved)
    if not rcOk then
      ColourNote("red","","BraeBear's Necessities: RefreshCoatFull error: " .. tostring(rcErr))
    else
      StartCoatTimer(resolved, target.label)
      SaveState()
      Draw()
    end
  end
