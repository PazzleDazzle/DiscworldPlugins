local function NormalizeWeaponPrefix(name)
  local n = string.lower(Trim(name or ""))
  n = n:gsub("^your%s+", ""):gsub("^the%s+", ""):gsub("^an?%s+", "")
  return n
end

local function ResolveWeaponIdentity(rawName)
  local normalized = NormalizeWeaponPrefix(rawName)
  if ALLOWED_WEAPONS[normalized] then return normalized, false end
  -- Fallback: match the whitelisted name as a whole word/phrase anywhere in
  -- the text, in case of some other prefix/suffix we didn't anticipate
  -- (e.g. "the wickedly curved shere khan dagger"). Word-boundaried so it
  -- won't fire on the word being embedded inside something unrelated.
  local lname = string.lower(rawName or "")
  for k,_ in pairs(ALLOWED_WEAPONS) do
    local escaped = k:gsub("(%W)", "%%%1")
    if lname:find("%f[%a]" .. escaped .. "%f[%A]") then
      return k, true
    end
  end
  return nil, false
end

function SetLastWeapon(name)
  name = Trim(name or "")
  if string.len(name) > 60 then return end
  if name:lower():find("contents of") then return end
  local resolved, wasLoose = ResolveWeaponIdentity(name)
  if not resolved then
    g_lastWeapon = nil
    g_pendingWeapon = nil
    g_gotCoat = false
    return
  end
  if wasLoose then
    ColourNote("yellow","","BraeBear's Necessities: loosely matched '" .. name .. "' to whitelisted weapon '" .. resolved .. "'")
  end
  g_lastWeapon = resolved
  g_pendingWeapon = resolved
  g_gotCoat = false
end

function CheckForNoCoat(condStr)
  condStr = Trim(condStr or "")
  local weapon = g_pendingWeapon or g_lastWeapon
  if not weapon then return end
  if not IsAllowed(weapon) then g_pendingWeapon=nil g_gotCoat=false return end
  local found=nil
  for i,v in ipairs(g_weapons) do if string.lower(v.name)==string.lower(weapon) then found=i break end end
  if found then
    g_weapons[found].condition = condStr
    g_weapons[found].time = os.time()
    if not g_gotCoat then g_weapons[found].level="none" end
  else
    local entry={name=weapon, level= g_gotCoat and "unknown" or "none", condition=condStr, time=os.time()}
    if #g_weapons >= g_maxWeapons then table.sort(g_weapons, function(a,b) return a.time < b.time end) g_weapons[1]=entry
    else table.insert(g_weapons, entry) end
  end
  if not g_gotCoat then
    for i,v in ipairs(g_weapons) do
      if string.lower(v.name)==string.lower(weapon) then
        if not v.level or v.level=="" or v.level=="unknown" then v.level="none" end
        v.condition=condStr
      end
    end
  end
  table.sort(g_weapons, function(a,b) return a.time > b.time end)
  while #g_weapons > g_maxWeapons do table.remove(g_weapons) end
  g_coatLastReal[string.lower(weapon)] = os.time()
  SaveState() Draw()
  g_pendingWeapon=nil g_gotCoat=false
end

function SetCoat(level, colourName, extra)
  local weapon = g_pendingWeapon or g_lastWeapon
  if not weapon or weapon=="" then return end
  if not IsAllowed(weapon) then return end
  level = Trim(string.lower(level or ""))
  g_gotCoat=true
  local found=nil
  for i,v in ipairs(g_weapons) do if string.lower(v.name)==string.lower(weapon) then found=i break end end
  if found then g_weapons[found].level=level g_weapons[found].time=os.time()
  else
    local entry={name=weapon, level=level, condition="", time=os.time()}
    if #g_weapons >= g_maxWeapons then table.sort(g_weapons, function(a,b) return a.time < b.time end) g_weapons[1]=entry
    else table.insert(g_weapons, entry) end
  end
  table.sort(g_weapons, function(a,b) return a.time > b.time end)
  while #g_weapons > g_maxWeapons do table.remove(g_weapons) end
  g_coatLastReal[string.lower(weapon)] = os.time()
  SaveState() Draw()
end

local function CalcNeededHeight()
  local header_h = (fh or 12) + 6
  local y = header_h + 3
  if g_showSections.weapons then
    if #g_weapons == 0 then y = y + (fh or 12) + 4
    else for i=1, math.min(g_maxWeapons, #g_weapons) do y = y + (fh or 12) + 1 + (fh or 12) + 3 end end
  end
  if g_showSections.armband then
    y = y + 1 + 3 + (fh or 12) + 1
    local slotCount=0 for _ in pairs(g_armband) do slotCount=slotCount+1 end
    if slotCount==0 then y=y+(fh or 12)+1 else y=y+slotCount*((fh or 12)+2) end
  end
  if g_showSections.canteens and #g_canteenConfig > 0 then
    y = y + 1 + 3 + (fh or 12) + 1 + #g_canteenConfig*((fh or 12)+1)
  end
  local preScrollsY = y
  if g_showSections.scrolls and #g_scrollConfig > 0 then
    y = y + 1 + 3 + (fh or 12) + 1 + #g_scrollConfig*((fh or 12)+1)
  end
  do
    local compCount = 0
    for _ in pairs(g_componentConfig) do compCount = compCount + 1 end
    if g_showSections.components and compCount > 0 then
      y = y + 1 + 3 + (fh or 12) + 1 + compCount*((fh or 12)+1)
    end
  end
  if g_showSections.tactics then
    y = y + 1 + 3 + (fh or 12) + 1 + 2*((fh or 12)+1)
  end
  if g_showSections.buffbear then
    -- Anchor the icon next to the JPCT/TPA text rather than reserving a
    -- whole extra strip below everything - only grow the window if the
    -- icon would otherwise stick out past the bottom of normal content.
    local iconAnchorTop
    if g_showSections.scrolls and #g_scrollConfig > 0 then
      iconAnchorTop = preScrollsY + 1 + 3 + ((fh or 12)+1)
    else
      iconAnchorTop = preScrollsY
    end
    y = math.max(y, iconAnchorTop + ICON_SIZE + PAD)
  end
  return y+8
end

function Draw()
  if not g_weapons then g_weapons={} end
  if not g_armband then g_armband={} end
  local header_h_preview = fh + 6
  if g_collapsed then
    win_h = header_h_preview + 4
  else
    local needed=CalcNeededHeight()
    if needed > win_h then win_h=needed elseif needed < win_h and not g_inArmband then win_h=math.max(MIN_H, needed) end
  end
  local x=tonumber(GetVariable(VK("pos_x"))) or 100
  local y=tonumber(GetVariable(VK("pos_y"))) or 100

  local themeCol
  if g_flashUntil ~= 0 and os.time() < g_flashUntil then themeCol = FLASH_COLOR
  elseif g_inCombat then themeCol = COL_BORDER_COMBAT
  else themeCol = g_accentColor end

  WindowCreate(win, x, y, win_w, win_h, 4, 2, COL_BG)
  WindowFont(win, "f", FONT_NAME, FONT_SIZE, false, false, false, false)
  WindowFont(win, "fb", FONT_NAME, FONT_SIZE, true, false, false, false)
  fh = WindowFontInfo(win, "f", 1) or 12
  WindowRectOp(win, 2, 0,0, win_w, win_h, COL_BG)
  WindowRectOp(win, 1, 0,0, win_w, win_h, themeCol)
  local header_h = fh + 6
  WindowRectOp(win, 2, 0,0, win_w, header_h, themeCol)
  local titleTxt = "BraeBear's Necessities" .. (g_locked and "  [locked]" or "") .. (g_collapsed and "  [+]" or "  [-]")
  WindowText(win, "f", titleTxt, PAD, 2, 0,0, COL_TITLE_FG, false)
  WindowAddHotspot(win, "header", 0,0, win_w, header_h, "", "", "md", "cancel", "up", "Drag / right-click for menu", 6, 0)
  WindowDragHandler(win, "header", "drag_move", "drag_release", 0)
  if not g_collapsed then
    WindowAddHotspot(win, "resize", win_w-12, win_h-12, win_w, win_h, "", "", "md", "cancel", "up", "Resize", 4, 0)
    WindowDragHandler(win, "resize", "drag_move", "drag_release", 0)
  end
  if g_collapsed then
    WindowShow(win, true)
    pcall(Redraw)
    return
  end
  local ypos = header_h + 3
  if g_showSections.weapons then
  if #g_weapons == 0 then
    WindowText(win, "f", "No weapons yet", PAD, ypos, 0,0, COL_TEXT, false)
    ypos = ypos + fh + 4
  else
    for i=1, math.min(g_maxWeapons, #g_weapons) do
      local w = g_weapons[i]
      local col = LEVEL_COLORS[w.level] or COL_TEXT
      local nameStr = w.name
      local condPercent = GetConditionPercent(w.condition)
      local condSegs = GetConditionSegments(w.condition)
      WindowText(win, "f", nameStr, PAD, ypos, win_w-PAD, 0, COL_TEXT, false)
      if w.condition and w.condition ~= "" then
        local nameW = WindowTextWidth(win, "f", nameStr)
        local barX = PAD + nameW + 8
        local barW = 90
        local barH = 12
        local barY = ypos + 1
        if barX + barW > win_w - PAD - 2 then barW = win_w - barX - PAD - 2 if barW < 30 then barW=30 end end
        DrawSegmentedBarGradient(win, barX, barY, barW, barH, condPercent or 0, 10, 3, condSegs)
      end
      ypos = ypos + fh + 1
      do
        local coatPct = GetCoatPercent(w.level)
        local coatSegs = GetCoatSegments(w.level)
        local coatW = 90
        local coatH = 12
        local coatX = PAD + 8
        local coatY = ypos + 1
        if coatX + coatW > win_w - PAD - 2 then coatW = win_w - coatX - PAD - 60 end
        DrawSegmentedBarGradient(win, coatX, coatY, coatW, coatH, coatPct or 0, 7, 3, coatSegs)
        local lvlText = w.level or "none"
        WindowText(win, "f", lvlText, coatX+coatW+6, ypos, win_w-PAD, 0, col, false)
      end
      ypos = ypos + fh + 3
    end
  end
  end
  if g_showSections.armband then
  WindowRectOp(win, 2, 0, ypos, win_w, ypos+1, COL_BORDER)
  ypos = ypos + 3
  WindowText(win, "f", "Armband:", PAD, ypos, 0,0, COL_TITLE_FG, false)
  ypos = ypos + fh + 1
  local slots={}
  for _,v in pairs(g_armband) do table.insert(slots, v) end
  table.sort(slots, function(a,b) return a.slot < b.slot end)
  if #slots == 0 then
    WindowText(win, "f", "  (examine armband)", PAD, ypos, 0,0, 0x888888, false)
    ypos = ypos + fh + 1
  else
    for _,s in ipairs(slots) do
      if s.count==0 and s.label=="empty" then
        WindowText(win, "f", string.format("Slot %d: empty", s.slot), PAD, ypos, win_w-PAD, 0, COL_TEXT, false)
        ypos = ypos + fh + 1
      else
        local slotPrefix = string.format("S%d:", s.slot)
        WindowText(win, "f", slotPrefix, PAD, ypos, win_w-PAD, 0, COL_TEXT, false)
        local prefW = WindowTextWidth(win, "f", slotPrefix)
        local barX = PAD + prefW + 6
        local barW = 70
        local barH = 11
        local barY = ypos + 1
        local pct = GetArmbandPercent(s.count)
        DrawSegmentedBarGradient(win, barX, barY, barW, barH, pct or 0, 8, 3, s.count)
        local txt2 = string.format("%d x %s", s.count, s.label)
        WindowText(win, "f", txt2, barX+barW+6, ypos, win_w-PAD, 0, COL_TEXT, false)
        ypos = ypos + fh + 1
      end
    end
  end
  end
  if g_showSections.canteens and #g_canteenConfig > 0 then
  WindowRectOp(win, 2, 0, ypos, win_w, ypos+1, COL_BORDER)
  ypos = ypos + 3
  WindowText(win, "f", "Canteens:", PAD, ypos, 0,0, COL_TITLE_FG, false)
  ypos = ypos + fh + 1
  for _,cfg in ipairs(g_canteenConfig) do
    local c = g_canteens[cfg.keyword]
    local lvl = c and c.level or nil
    local pct = lvl and (lvl/6*100) or 0
    local labelPrefix = cfg.name .. ":"
    WindowText(win, "f", labelPrefix, PAD, ypos, 0,0, COL_TEXT, false)
    local prefW = WindowTextWidth(win, "f", labelPrefix)
    local barX = PAD + prefW + 6
    local barW = 80
    local barH = 11
    local barY = ypos + 1
    DrawSegmentedBarGradient(win, barX, barY, barW, barH, pct, 6, 3, lvl)
    local statusTxt = lvl ~= nil and (CANTEEN_LABELS[lvl] or "?") or "unknown"
    WindowText(win, "f", statusTxt, barX+barW+6, ypos, win_w-PAD, 0, COL_TEXT, false)
    ypos = ypos + fh + 1
  end
  end
  local preScrollsY = ypos
  if g_showSections.scrolls and #g_scrollConfig > 0 then
  WindowRectOp(win, 2, 0, ypos, win_w, ypos+1, COL_BORDER)
  ypos = ypos + 3
  WindowText(win, "f", "Scrolls:", PAD, ypos, 0,0, COL_TITLE_FG, false)
  ypos = ypos + fh + 1
  for _,cfg in ipairs(g_scrollConfig) do
    WindowText(win, "f", cfg.counter .. ": " .. tostring(g_scrollCounters[cfg.counter] or 0), PAD, ypos, win_w-PAD, 0, COL_TEXT, false)
    ypos = ypos + fh + 1
  end
  end
  do
    local compNames = {}
    for name,_ in pairs(g_componentConfig) do table.insert(compNames, name) end
    table.sort(compNames)
    if g_showSections.components and #compNames > 0 then
      WindowRectOp(win, 2, 0, ypos, win_w, ypos+1, COL_BORDER)
      ypos = ypos + 3
      WindowText(win, "f", "Components:", PAD, ypos, 0,0, COL_TITLE_FG, false)
      ypos = ypos + fh + 1
      for _,name in ipairs(compNames) do
        WindowText(win, "f", name .. ": " .. tostring(g_components[name] or 0), PAD, ypos, win_w-PAD, 0, COL_TEXT, false)
        ypos = ypos + fh + 1
      end
    end
  end
  if g_showSections.tactics then
  WindowRectOp(win, 2, 0, ypos, win_w, ypos+1, COL_BORDER)
  ypos = ypos + 3
  WindowText(win, "f", "Tactics:", PAD, ypos, 0,0, COL_TITLE_FG, false)
  ypos = ypos + fh + 1
  do
    local labelPrefix = "Attitude:"
    WindowText(win, "f", labelPrefix, PAD, ypos, 0,0, COL_TEXT, false)
    local prefW = WindowTextWidth(win, "f", labelPrefix)
    local letters = {"W","D","N","O","I"}
    local keys = {"wimp","defensive","neutral","offensive","insane"}
    local xpos = PAD + prefW + 8
    for i,letter in ipairs(letters) do
      local isCurrent = (g_attitude == keys[i])
      local font = isCurrent and "fb" or "f"
      local col = isCurrent and 0x00CC00 or 0x999999
      WindowText(win, font, letter, xpos, ypos, 0,0, col, false)
      xpos = xpos + WindowTextWidth(win, font, letter) + 7
    end
    ypos = ypos + fh + 1
  end
  WindowText(win, "f", "Focus: " .. g_focusZone, PAD, ypos, win_w-PAD, 0, COL_TEXT, false)
  ypos = ypos + fh + 1
  end
  if g_showSections.buffbear then
    -- Decode and load only the single image needed right now, rather than
    -- preloading all 48 - this window gets recreated (WindowCreate) on
    -- every Draw() call, which wipes any previously loaded images anyway,
    -- and decoding one ~9-14KB image is a couple of milliseconds.
    local key = ComboKey()
    local b64 = IMAGES[key]
    if not b64 then
      ColourNote("red","","BraeBear's Necessities: BuffBear debug: no image for key '" .. tostring(key) .. "'")
    else
      local raw = base64_decode(b64)
      local sigOk = raw:sub(1,8) == PNG_SIGNATURE
      if not sigOk then
        ColourNote("red","","BraeBear's Necessities: BuffBear debug: decoded '" .. key .. "' failed PNG signature check (len=" .. #raw .. ")")
      end
      local loadOk, loadCode = pcall(WindowLoadImageMemory, win, key, raw)
      if not loadOk then
        ColourNote("red","","BraeBear's Necessities: BuffBear debug: WindowLoadImageMemory errored: " .. tostring(loadCode))
      elseif loadCode ~= 0 then
        ColourNote("red","","BraeBear's Necessities: BuffBear debug: WindowLoadImageMemory('" .. key .. "') returned code " .. tostring(loadCode) .. " (decoded " .. #raw .. " bytes)")
      else
        local iconAnchorTop
        if g_showSections.scrolls and #g_scrollConfig > 0 then
          iconAnchorTop = preScrollsY + 1 + 3 + (fh + 1)
        else
          iconAnchorTop = preScrollsY
        end
        local iconRight = win_w - PAD
        local iconLeft = iconRight - ICON_SIZE
        local iconTop = iconAnchorTop
        local iconBottom = iconTop + ICON_SIZE
        local drawOk, drawCode = pcall(WindowDrawImage, win, key, iconLeft, iconTop, iconRight, iconBottom, miniwin.image_stretch, 0, 0, 0, 0)
        if not drawOk then
          ColourNote("red","","BraeBear's Necessities: BuffBear debug: WindowDrawImage errored: " .. tostring(drawCode))
        elseif drawCode ~= 0 then
          ColourNote("red","","BraeBear's Necessities: BuffBear debug: WindowDrawImage('" .. key .. "') returned code " .. tostring(drawCode) .. " at (" .. iconLeft .. "," .. iconTop .. ")-(" .. iconRight .. "," .. iconBottom .. ") win=" .. win_w .. "x" .. win_h)
        end
      end
    end
  end
  WindowShow(win, true)
  pcall(Redraw)
end

local drag_sx, drag_sy, orig_w, orig_h, drag_mx, drag_my

function md(f,id)
  if g_locked then return end
  drag_mx=WindowInfo(win,17) drag_my=WindowInfo(win,18)
  drag_sx=WindowInfo(win,14) drag_sy=WindowInfo(win,15)
  orig_w=win_w orig_h=win_h
end

function drag_move(f,id)
  if g_locked then return end
  local mx=WindowInfo(win,17) local my=WindowInfo(win,18)
  if id=="header" then
    WindowPosition(win, mx-drag_sx, my-drag_sy, 4,2)
  elseif id=="resize" then
    win_w=math.max(MIN_W, orig_w+(mx-drag_mx))
    win_h=math.max(MIN_H, orig_h+(my-drag_my))
    WindowResize(win, win_w, win_h, COL_BG)
    pcall(Redraw) -- live preview while dragging (WindowResize keeps hotspots/fonts, unlike WindowCreate)
  end
end

function drag_release(f,id)
  if g_locked then return end
  local nx=WindowInfo(win,10) local ny=WindowInfo(win,11)
  if nx and nx>=0 then SetVariable(VK("pos_x"), tostring(nx)) end
  if ny and ny>=0 then SetVariable(VK("pos_y"), tostring(ny)) end
  SetVariable("win_w", tostring(win_w)) SetVariable("win_h", tostring(win_h))
  if id~="header" then Draw() end
end

function cancel() end

function up(f,id)
  if id=="header" and bit.band(f, miniwin.hotspot_got_rh_mouse) ~= 0 then
    ShowContextMenu()
  end
end

function ResetWindowGeometry()
  win_w = 280
  win_h = 150
  SetVariable(VK("pos_x"), "100")
  SetVariable(VK("pos_y"), "100")
  SaveState()
  Draw()
  ColourNote("palegreen","","BraeBear's Necessities: window position/size reset")
end

function ToggleCollapse()
  g_collapsed = not g_collapsed
  SaveState()
  Draw()
end

function ChangeAccentColor()
  local ok, result = pcall(PickColour, g_accentColor)
  if ok and result and result ~= -1 then
    g_accentColor = result
    SaveState()
    Draw()
    ColourNote("palegreen","","BraeBear's Necessities: out-of-combat color updated")
  end
end

function ShowContextMenu()
  local function chk(b) return (b and "+" or "") end
  local function chkColor(c) return (g_tpa and g_tpaColor == c and "+" or "") end
  local items = "~LT" ..
    chk(g_locked) .. "Lock window|" ..
    chk(g_collapsed) .. "Collapse|-|" ..
    ">Show sections|" ..
      chk(g_showSections.weapons) .. "Weapons|" ..
      chk(g_showSections.armband) .. "Armband|" ..
      chk(g_showSections.canteens) .. "Canteens|" ..
      chk(g_showSections.scrolls) .. "Scrolls|" ..
      chk(g_showSections.buffbear) .. "BuffBear icon|" ..
      chk(g_showSections.tactics) .. "Tactics|" ..
    "<|" ..
    ">BuffBear buffs|" ..
      chk(g_tpa) .. "TPA shield|" ..
      chk(g_ccc) .. "CCC (stony skin)|" ..
      chk(g_light) .. "Permanent light|" ..
      chk(g_darksight) .. "Dark sight|" ..
    "<|" ..
    ">TPA shield color|" ..
      chkColor("invisible") .. "invisible|" ..
      chkColor("dull red") .. "dull red|" ..
      chkColor("bright red") .. "bright red|" ..
      chkColor("wobbling orange") .. "wobbling orange|" ..
      chkColor("flickering yellow") .. "flickering yellow|" ..
    "<|" ..
    ">Sound alerts|" ..
      chk(g_soundEnabled) .. "Enabled|" ..
      "Test sound|" ..
      "Sound file info|" ..
    "<|" ..
    "Change out-of-combat color...|" ..
    ">Naming & mappings|" ..
      "View weapon whitelist|" ..
      "View canteen mappings|" ..
      "View scroll mappings|" ..
      "View armband container name|" ..
      "Set light item...|" ..
    "<|" ..
    "Profile info|-|" ..
    "Reset size/position"

  local mx, my = WindowInfo(win, 14), WindowInfo(win, 15)
  if not mx or not my then return end
  local result = WindowMenu(win, mx, my, items)
  if result == "" then return end

  if result == "Lock window" then
    g_locked = not g_locked
    SaveState()
    Draw()
    ColourNote("palegreen","","BraeBear's Necessities: window " .. (g_locked and "locked" or "unlocked"))
  elseif result == "Collapse" then
    ToggleCollapse()
  elseif result == "Weapons" or result == "Armband" or result == "Canteens" or result == "Scrolls" or result == "Tactics" then
    local key = string.lower(result)
    g_showSections[key] = not g_showSections[key]
    SaveState()
    Draw()
  elseif result == "BuffBear icon" then
    g_showSections.buffbear = not g_showSections.buffbear
    SaveState()
    Draw()
  elseif result == "TPA shield" then SetTPA(not g_tpa)
  elseif result == "CCC (stony skin)" then SetCCC(not g_ccc)
  elseif result == "Permanent light" then SetLight(not g_light)
  elseif result == "Dark sight" then SetDarksight(not g_darksight)
  elseif TPA_COLOR_KEYS[result] then SetTPAColor(result)
  elseif result == "Set light item..." then SetLightItem("")
  elseif result == "Enabled" then
    ToggleSound()
  elseif result == "Test sound" then
    PlayAlertSound(true)
  elseif result == "Sound file info" then
    ColourNote("cyan","","BraeBear's Necessities: sound file = " .. (g_soundFile ~= "" and g_soundFile or "(none set)"))
    ColourNote("cyan","","Set one with: bbsound <path to .wav>")
  elseif result == "Change out-of-combat color..." then
    ChangeAccentColor()
  elseif result == "View weapon whitelist" then
    ShowWhitelist()
  elseif result == "View canteen mappings" then
    ListCanteenMappings()
  elseif result == "View scroll mappings" then
    ListScrollMappings()
  elseif result == "View armband container name" then
    SetArmbandName("")
  elseif result == "Profile info" then
    SwitchProfile("")
  elseif result == "Reset size/position" then
    ResetWindowGeometry()
  end
end

function OnPluginInstall() LoadState() Draw() ColourNote("palegreen","","BraeBear's Necessities v3.5 in-game alias forward") end
function OnPluginEnable() WindowShow(win,true) end
function OnPluginDisable() WindowShow(win,false) end
function OnPluginSaveState()
  SaveState()
  local nx=WindowInfo(win,10) local ny=WindowInfo(win,11)
  if nx and nx>=0 then SetVariable(VK("pos_x"), tostring(nx)) end
  if ny and ny>=0 then SetVariable(VK("pos_y"), tostring(ny)) end
end
function OnPluginClose() OnPluginSaveState() WindowShow(win,false) end
function HandleCoatFailure()
  ConsumeArmbandDose(g_nextCoatWeapon, " (spilled - coat not applied)")
  g_nextCoatSlot = nil
  g_nextCoatWeapon = nil
  ColourNote("orange","","BraeBear's Necessities: coating spilled - coat level unchanged")
end

function ClearCoats() g_weapons={} g_armband={} g_canteens={} for k,_ in pairs(g_scrollCounters) do g_scrollCounters[k]=0 end SaveState() Draw() ColourNote("yellow","","Cleared (whitelist and mappings kept)") end

LoadState()
